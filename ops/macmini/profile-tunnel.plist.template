<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arronnrock.profile-gateway-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/Application Support/SurgeProfileGateway/bin/profile-tunnel.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/SurgeProfileGateway/profile-tunnel.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/SurgeProfileGateway/profile-tunnel.err.log</string>
</dict>
</plist>
